#RANDOM 2
#IF 1
#00111:01
#ENDIF
#IF 2
#00112:01
#ENDIF
#ENDRANDOM
#ENDIF
#IF 2
#RANDOM 2
#IF 1
#00113:01
#ENDIF
#IF 2
#00114:01
#ENDIF
#ENDRANDOM
#ENDIF
#ENDRANDOM
