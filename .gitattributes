* text=auto eol=lf
*.rs   text eol=lf diff=rust
*.md   text eol=lf diff=markdown
*.toml text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.nix  text eol=lf
*.sh   text eol=lf
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf
Cargo.lock text eol=lf linguist-generated
