# Skin definition tokens for the skin_json target (libFuzzer -dict format).

# Structure and wrappers.
"\"type\": 0"
"\"w\": 1920, \"h\": 1080"
"\"include\""
"\"if\""
"\"value\""
"\"values\""
"\"property\""
"\"filepath\""
"\"offset\""
"\"offsets\""
"\"customTimers\""

# Object tables.
"\"source\""
"\"font\""
"\"image\""
"\"imageset\""
"\"text\""
"\"destination\""
"\"dst\""

# Fields.
"\"id\""
"\"src\""
"\"path\""
"\"divx\""
"\"divy\""
"\"cycle\""
"\"timer\""
"\"loop\""
"\"op\""
"\"draw\""
"\"blend\""
"\"filter\""
"\"stretch\""
"\"center\""
"\"time\""
"\"acc\""
"\"angle\""
"\"digit\""
"\"ref\""
"\"align\""
"\"space\""
"\"padding\""
"\"zeropadding\""
"\"constantText\""
"\"overflow\""
"\"size\""
"\"def\""

# The resources of the skin folder.
"strip.png"
"grid.png"
"font.ttf"
"*.png"
