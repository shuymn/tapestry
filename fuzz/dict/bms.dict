# BMS tokens for the bms_load target (libFuzzer -dict format).

# Header directives.
"#PLAYER "
"#TITLE "
"#SUBTITLE "
"#ARTIST "
"#SUBARTIST "
"#GENRE "
"#COMMENT "
"#BPM "
"#BPM01 "
"#STOP01 "
"#WAV01 "
"#WAVZZ "
"#BMP01 "
"#BACKBMP "
"#BANNER "
"#STAGEFILE "
"#PREVIEW "
"#VOLWAV "
"#RANK "
"#DEFEXRANK "
"#TOTAL "
"#PLAYLEVEL "
"#DIFFICULTY "
"#LNOBJ "
"#LNTYPE "
"#LNMODE "

# Control flow.
"#RANDOM "
"#SETRANDOM "
"#IF "
"#ELSEIF "
"#ELSE"
"#ENDIF"
"#ENDRANDOM"
"#SWITCH "
"#SETSWITCH "
"#CASE "
"#SKIP"
"#DEF"
"#ENDSW"

# Channel lines: measure, channel, colon.
"#00101:"
"#00102:"
"#00103:"
"#00108:"
"#00109:"
"#00111:"
"#00116:"
"#00119:"
"#00151:"
"#00156:"
"#001D1:"
"#999"

# Object pairs and values.
"00"
"01"
"ZZ"
"0.5"
"120"
"\x0d\x0a"
"\x0a"
